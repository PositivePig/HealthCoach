# HealthCoachAgent - 环境变量示例
# 复制为 .env 并填入实际值
# cp .env.example .env

# ============== App ==============
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ============== LLM Providers ==============
# 至少配置一个；router 会按 main_chat / vision / router 三种角色逐一尝试

# DeepSeek（首选 main_chat / router，国内便宜大碗）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MAIN_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# DashScope (Qwen, 阿里) - 视觉首选
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_VL_MODEL=qwen-vl-plus
DASHSCOPE_TEXT_MODEL=qwen-plus

# Anthropic Claude (可选, 关键决策时使用)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI (可选, GPT-5V fallback)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VL_MODEL=gpt-4o

# 本地 vLLM（可选 fallback）
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=Qwen/Qwen3-14B-Instruct-AWQ
LOCAL_VL_BASE_URL=
LOCAL_VL_MODEL=Qwen/Qwen3-VL-7B

# ============== Storage ==============
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=healthcoach
POSTGRES_PASSWORD=healthcoach_dev
POSTGRES_DB=healthcoach

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ============== Observability (Langfuse) ==============
# 自部署：访问 http://localhost:3001 注册 → 拿 keys 填进来
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENABLED=false   # W1 拿到 keys 后改 true
